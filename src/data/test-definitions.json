  "60": {
    "id": "60",
    "label": "60問版",
    "source": {
      "questions": "src/data/test-definitions.json",
      "convertedFrom": "ref/60/Japanese_self60.doc",
      "scoring": "ref/60/ScoringKeys_60.pdf",
      "descriptives": "ref/60/descriptives_60.pdf"
    },
    "responseOptions": [
      "あてはまらない（そうではない）",
      "どちらかといえば，あてはまらない",
      "どちらともいえない",
      "どちらかといえば，あてはまる",
      "あてはまる（そうである）"
    ],
    "questions": [
      {
        "id": 1,
        "text": "美術館に行くと，とても退屈してしまう。"
      },
      {
        "id": 2,
        "text": "最後になってあわてないために，前もって計画を立ててものごとの準備をする。"
      },
      {
        "id": 3,
        "text": "たとえひどく不当な扱いをされた相手に対しても，めったに悪意を抱くことはない。"
      },
      {
        "id": 4,
        "text": "私は全体的に自分自身にほどよく満足していると感じている。"
      },
      {
        "id": 5,
        "text": "悪天候のときに旅行をしなければならないとしたら，怖れを感じる。"
      },
      {
        "id": 6,
        "text": "たとえそうすればうまくいくと思っても，仕事の上で昇進するためにお世辞を言ったりしようとは思わない。"
      },
      {
        "id": 7,
        "text": "他の国の歴史や政治について学ぶことに興味がある。"
      },
      {
        "id": 8,
        "text": "目標を達成しようとするときは，しばしば自分をとても激しく追い詰める。"
      },
      {
        "id": 9,
        "text": "人からときどき，他人に対して批判的すぎると言われる。"
      },
      {
        "id": 10,
        "text": "集団での話し合いでは，自分の意見を言うことはめったにない。"
      },
      {
        "id": 11,
        "text": "ちょっとしたことが心配になって，それを抑えることができないことがある。"
      },
      {
        "id": 12,
        "text": "もし決して捕まらないとわかっているのなら，私は1億円を盗もうと思う。"
      },
      {
        "id": 13,
        "text": "小説を書いたり，曲を作ったり，絵を描いたりといった，芸術作品を創作することは楽しい。"
      },
      {
        "id": 14,
        "text": "何かの仕事をするとき，細かい点にはあまり注意を払わない。"
      },
      {
        "id": 15,
        "text": "ときどき人から，私は頑固すぎると言われる。"
      },
      {
        "id": 16,
        "text": "一人でやるよりも，積極的な人との関わりを含む仕事の方が好きだ。"
      },
      {
        "id": 17,
        "text": "苦痛な体験に苦しんでいるときには，慰めを与えてくれる人が必要である。"
      },
      {
        "id": 18,
        "text": "大金を持つことは，自分にとって特に重要なことではない。"
      },
      {
        "id": 19,
        "text": "とても斬新で慣習にとらわれない考えを考慮することは，時間の無駄だと思う。"
      },
      {
        "id": 20,
        "text": "私は，よく考えた上でよりも，そのときの気持ち次第で物事を決める（ことがある）。"
      },
      {
        "id": 21,
        "text": "他の人は，私のことを短気な人間だと思っている。"
      },
      {
        "id": 22,
        "text": "たいていは，元気で楽天的である。"
      },
      {
        "id": 23,
        "text": "他の人が泣いているのをみると，私も泣きたくなる。"
      },
      {
        "id": 24,
        "text": "私は，平均的な人間よりも，尊重される権利があると思う。"
      },
      {
        "id": 25,
        "text": "もし機会があれば，クラシック音楽の演奏会に行きたい。"
      },
      {
        "id": 26,
        "text": "仕事をしているとき，ときどき自分がだらしがないために困ってしまうことがある。"
      },
      {
        "id": 27,
        "text": "私にひどいことをした人に対する私の態度は，「許して忘れる」ことである。"
      },
      {
        "id": 28,
        "text": "自分は人気がない人間だと感じている。"
      },
      {
        "id": 29,
        "text": "身体的な危険が迫ると，とても怖い。"
      },
      {
        "id": 30,
        "text": "もし，何かをある人から手に入れようと思っているときには，その人がくだらない冗談を言っても笑うだろう。"
      },
      {
        "id": 31,
        "text": "百科事典を読むことを楽しんだことはない。"
      },
      {
        "id": 32,
        "text": "必要とされる最低限の仕事しかしない。"
      },
      {
        "id": 33,
        "text": "他の人を判断するときには，甘い（手加減する）傾向がある。"
      },
      {
        "id": 34,
        "text": "社会的（対人）場面では，たいてい私がはじめに行動する人間である。"
      },
      {
        "id": 35,
        "text": "他の人ほどは心配性ではない。"
      },
      {
        "id": 36,
        "text": "たとえどんなに大金でも，賄賂は決して受け取らない。"
      },
      {
        "id": 37,
        "text": "人から，よく私は優れた想像力を持っていると言われることがある。"
      },
      {
        "id": 38,
        "text": "たとえ時間がかかっても，自分の仕事ではいつも正確であるようにしている。"
      },
      {
        "id": 39,
        "text": "人が私に同調しないときは，私はたいてい自分の意見について，かなり柔軟である。"
      },
      {
        "id": 40,
        "text": "新しい場所に行っていつも最初にすることは，友達を作ることである。"
      },
      {
        "id": 41,
        "text": "誰かの感情的な支えがないとしても，困難な状況に対処することができる。"
      },
      {
        "id": 42,
        "text": "高価で贅沢なものを所有することで，多くの楽しみが得られる。"
      },
      {
        "id": 43,
        "text": "私は，ny欀つ型にはまらない見方をする人が好きである。"
      },
      {
        "id": 44,
        "text": "行動する前に考えないので，たくさんの失敗をしてしまう。"
      },
      {
        "id": 45,
        "text": "たいていの人は，私よりもすぐに怒り出す。"
      },
      {
        "id": 46,
        "text": "たいていの人は，私よりも陽気で活発である。"
      },
      {
        "id": 47,
        "text": "自分と親しい人が長い間遠くに行ってしまうときには，強い感情を感じる。"
      },
      {
        "id": 48,
        "text": "私が高い地位にいる重要な人間であることを他の人に知ってほしい。"
      },
      {
        "id": 49,
        "text": "自分のことを，芸術家タイプとか，創造的なタイプであるとは思わない。"
      },
      {
        "id": 50,
        "text": "人からしばしば完全主義者だと言われる。"
      },
      {
        "id": 51,
        "text": "たとえ人がたくさん間違いを犯したときでも，私はめったに否定的なことは言わない。"
      },
      {
        "id": 52,
        "text": "自分は価値のない人間だと感じる。"
      },
      {
        "id": 53,
        "text": "たとえ非常時の場合でも，あわてふためいたりすることはない。"
      },
      {
        "id": 54,
        "text": "誰かに私のたのみを聞いてもらうために，その人を好きなふりをしようとは思わない。"
      },
      {
        "id": 55,
        "text": "哲学について議論するのは，うんざりである。"
      },
      {
        "id": 56,
        "text": "私は，何でも計画通りにするよりも，思いついたことをするのが好きである。"
      },
      {
        "id": 57,
        "text": "人から私が間違っていると言われたとき，私の最初の反応は，相手に同意しないことである。"
      },
      {
        "id": 58,
        "text": "集団の中にいるとき，しばしばその集団を代表して話をする人間である。"
      },
      {
        "id": 59,
        "text": "たいていの人がとても感傷的になるような状況でも，私は冷静でいられる。"
      },
      {
        "id": 60,
        "text": "もし絶対に捕まらないなら，偽札を使ってみたい。"
      }
    ],
